{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mamut:results:1",
  "title": "results/1 — static, P-Delta, modal, spectrum and linear buckling",
  "description": "Canonical SI results. Mass-normalized modes φᵀMφ=1. buckling holds the factors of K + lambda Kg = 0; modes stays the mass-normalized list and is empty for that method. normalization negative_kg means phi^T (-Kg) phi = 1. The Timoshenko-Gere page is unknown. P-Delta only includes lateral displacements/reactions independent of gravity; empty members (#84(c)). Spectrum: signed modal responses and component envelopes, without simultaneous equilibrium. null direction/factor marks the final directional envelope. Errors have no partial responses; convergence retains P-Delta diagnostics for notConverged/unstable. SFC-010: geotechnical appears only in geotechnical analyses. Newton convergence retains results and histories of accepted steps, even after a subsequent failure; cases contains only the last step if the entire run completes. Newton extrema are sampled at five stations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine_version", "contracts", "methods", "input_sha256", "status", "nodes", "members", "modes", "cases", "envelopes", "convergence", "diagnostics", "combinations"],
  "properties": {
    "schema": {"const": "results/1"},
    "engine_version": {"type": "string"},
    "git_commit": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$", "description": "Revision supplied through MAMUT_ENGINE_GIT_COMMIT at build time; null if absent or not a 40/64-character hexadecimal revision. Optional for older documents."},
    "target": {"type": "string", "description": "Cargo TARGET triple captured at build time. Optional for older documents."},
    "contracts": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"enum": ["linearStatic", "pDelta", "modal", "responseSpectrum", "nonlinearStatic", "soilProfile", "consolidation1d", "buckling.linear"]}},
    "input_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the input's RFC 8785 (JCS) UTF-8 bytes via mamut-canon v0.1.0; null if parsing/fingerprinting did not complete. Replaces the custom canonicalization from #88."},
    "status": {"enum": ["ok", "invalid", "unsupported", "cancelled", "notConverged", "unstable", "warning", "timeout", "internalError"]},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/nodeIdentity"}},
    "members": {"type": "array", "items": {"$ref": "#/$defs/memberIdentity"}},
    "modes": {"type": "array", "items": {"$ref": "#/$defs/mode"}},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "envelopes": {"type": "array", "items": {"$ref": "#/$defs/envelope"}},
    "combinations": {"type": "array", "items": {"$ref": "#/$defs/combination"}},
    "convergence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pDeltaConvergence"}, {"$ref": "#/$defs/newton_convergence"}]},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "geotechnical": {"oneOf": [{"$ref": "#/$defs/soil_result"}, {"$ref": "#/$defs/consolidation_result"}]},
    "buckling": {"$ref": "#/$defs/buckling_result"}
  },
  "$defs": {
    "nodeIdentity": {"type": "object", "additionalProperties": false, "required": ["id", "dim", "coordinates", "dofs"], "allOf": [{"if": {"properties": {"dim": {"const": "D2"}}}, "then": {"properties": {"coordinates": {"prefixItems": [{}, {}, {"const": 0}]}}}}], "properties": {"id": {"$ref": "#/$defs/id"}, "dim": {"enum": ["D2", "D3"]}, "coordinates": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "dofs": {"type": "array", "items": {"$ref": "#/$defs/dof"}}}},
    "dof": {"enum": ["Ux", "Uy", "Uz", "Rx", "Ry", "Rz"]},
    "memberIdentity": {"type": "object", "additionalProperties": false, "required": ["id", "nodes", "element", "section", "law"], "properties": {"id": {"$ref": "#/$defs/id"}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 2}, "element": {"type": "string"}, "section": {"type": "string"}, "law": {"type": "string"}, "end_dofs": {"type": "array", "items": {"type": "string"}, "description": "Local end_forces_local labels for springs, including moving end j connected to ground. Optional; absent from historical members."}}},
    "combination": {"type": "object", "additionalProperties": false, "required": ["id", "results"], "properties": {"id": {"type": "string"}, "results": {"$ref": "#/$defs/case"}}},
    "id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "vector6": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "displacements", "prescribed_displacements", "reactions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "displacements": {"$ref": "#/$defs/vector6"},
        "prescribed_displacements": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 6, "maxItems": 6},
        "reactions": {"$ref": "#/$defs/vector6"}
      }
    },
    "station": {
      "type": "object", "additionalProperties": false, "required": ["position", "forces_local"],
      "properties": {
        "position": {"type": "number", "minimum": 0, "maximum": 1},
        "forces_local": {"$ref": "#/$defs/vector6"}
      }
    },
    "extreme": {
      "type": "object", "additionalProperties": false, "required": ["value", "at_station"],
      "properties": {
        "value": {"type": "number"},
        "at_station": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "fieldExtremes": {
      "type": "object", "additionalProperties": false, "required": ["field", "max", "min"],
      "properties": {
        "field": {"enum": ["N", "Vy", "Vz", "T", "My", "Mz"]},
        "max": {"$ref": "#/$defs/extreme"},
        "min": {"$ref": "#/$defs/extreme"}
      }
    },
    "member": {
      "type": "object", "additionalProperties": false, "required": ["id", "end_forces_local", "stations", "extremes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "end_forces_local": {"type": "array", "items": {"type": "number"}},
        "stations": {"type": "array", "items": {"$ref": "#/$defs/station"}},
        "extremes": {"type": "array", "items": {"$ref": "#/$defs/fieldExtremes"}, "minItems": 6, "maxItems": 6}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["case", "factor", "nodes", "members"],
      "properties": {
        "case": {"type": "string"},
        "factor": {"type": "number"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["node", "member", "dof", "case", "law"]},
        "id": {"type": ["integer", "string"]}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["code", "severity", "entities", "cause", "hint"],
      "properties": {
        "code": {"type": "string", "pattern": "^(ENG-E-[0-9]{4}|API-[EWI]-[A-Z-]+)$"},
        "severity": {"enum": ["info", "warning", "error"]},
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "cause": {"type": "string"},
        "hint": {"type": ["string", "null"]},
        "entity_kind": {"type": "string", "description": "Kind of the missing entity on a broken reference. Absent on every other diagnostic."},
        "missing_id": {"type": ["integer", "string"], "description": "Id that was sought. Absent when entity_kind is absent."},
        "referenced_by": {"type": "string", "description": "Path of the citation, for example members[3].nodes[1]. Each index is the 0-based position in that model collection."},
        "suggestions": {"type": "array", "items": {"type": "string"}, "maxItems": 3, "description": "Nearby ids of the same kind, ordered by the documented Levenshtein rule. Absent when none qualify."}
      }
    },
    "participation": {
      "type": "object", "additionalProperties": false, "required": ["direction", "total_mass", "free_mass", "factor", "effective_mass", "cumulative_effective_mass", "mass_fraction", "cumulative_mass_fraction"],
      "properties": {
        "direction": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "total_mass": {"type": "number"},
        "free_mass": {"type": "number"},
        "factor": {"type": "number"},
        "effective_mass": {"type": "number"},
        "cumulative_effective_mass": {"type": "number"},
        "mass_fraction": {"type": ["number", "null"]},
        "cumulative_mass_fraction": {"type": ["number", "null"]}
      }
    },
    "spectrumResponse": {
      "type": "object", "additionalProperties": false, "required": ["direction", "damping", "spectral_acceleration", "modal_displacement", "equivalent_forces", "nodes", "base_shear"],
      "properties": {
        "direction": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "damping": {"type": "number"},
        "spectral_acceleration": {"type": "number"},
        "modal_displacement": {"type": "number"},
        "equivalent_forces": {"type": "array", "items": {"type": "number"}},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "base_shear": {"type": "number"}
      }
    },
    "mode": {
      "type": "object", "additionalProperties": false, "required": ["mode", "eigenvalue", "angular_frequency", "frequency_hz", "period", "normalization", "shape", "participation", "spectrum_responses"],
      "properties": {
        "mode": {"type": "integer", "minimum": 1},
        "eigenvalue": {"type": "number"},
        "angular_frequency": {"type": "number"},
        "frequency_hz": {"type": "number"},
        "period": {"type": ["number", "null"]},
        "normalization": {"const": "mass"},
        "shape": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "participation": {"type": "array", "items": {"$ref": "#/$defs/participation"}},
        "spectrum_responses": {"type": "array", "items": {"$ref": "#/$defs/spectrumResponse"}}
      }
    },
    "envelope": {
      "type": "object", "additionalProperties": false, "required": ["direction", "factor", "nodes", "base_shear"],
      "properties": {
        "direction": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}]},
        "factor": {"type": ["number", "null"]},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "base_shear": {"type": "number"}
      }
    },
    "caseFactor": {
      "type": "object", "additionalProperties": false, "required": ["case", "factor"],
      "properties": {
        "case": {"type": "string"},
        "factor": {"type": "number"}
      }
    },
    "pDeltaIteration": {
      "type": "object", "additionalProperties": false, "required": ["iteration", "relative_displacement_change", "free_residual_norm", "relative_free_residual"],
      "properties": {
        "iteration": {"type": "integer", "minimum": 1},
        "relative_displacement_change": {"type": "number"},
        "free_residual_norm": {"type": "number"},
        "relative_free_residual": {"type": "number"},
        "residual_convergence_ratio": {"type": "number", "minimum": 0, "description": "Maximum over free DOFs of |r_i|/(tolerance·ref_group + 64·m_i·eps·(|K+Kg||u|)_i); forces and moments have separate references. Converges if <= 1 and the relative displacement change criterion is satisfied."}
      }
    },
    "pDeltaConvergence": {
      "type": "object", "additionalProperties": false, "required": ["method", "status", "gravity", "lateral", "tolerance", "max_iterations", "displacement_scale", "rotation_scale", "inertia", "inertia_uses_2x2", "iterations"],
      "properties": {
        "method": {"const": "pDelta"},
        "status": {"enum": ["ok", "notConverged", "unstable"]},
        "gravity": {"$ref": "#/$defs/caseFactor"},
        "lateral": {"$ref": "#/$defs/caseFactor"},
        "tolerance": {"type": "number"},
        "max_iterations": {"type": "integer", "minimum": 1},
        "displacement_scale": {"type": "number"},
        "rotation_scale": {"type": "number"},
        "inertia": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 3, "maxItems": 3},
        "inertia_uses_2x2": {"type": ["boolean", "null"]},
        "iterations": {"type": "array", "items": {"$ref": "#/$defs/pDeltaIteration"}}
      }
    },
    "newton_step": {"type": "object", "additionalProperties": false, "required": ["load_factor", "iterations", "converged", "force_norm", "displacement_norm", "energy_norm", "relative_force_norm", "relative_displacement_norm", "relative_energy_norm", "results", "element_states"], "properties": {"load_factor": {"type": "number"}, "iterations": {"type": "integer", "minimum": 1}, "converged": {"type": "boolean"}, "force_norm": {"type": "number"}, "displacement_norm": {"type": "number"}, "energy_norm": {"type": "number"}, "relative_force_norm": {"type": "number"}, "relative_displacement_norm": {"type": "number"}, "relative_energy_norm": {"type": "number"}, "results": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/case"}]}, "element_states": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}]}}},
    "newton_convergence": {"type": "object", "additionalProperties": false, "required": ["method", "case", "status", "accepted_factor", "tolerance", "max_iterations", "force_scale", "displacement_tolerance", "energy_tolerance", "displacement_scale", "energy_scale", "steps"], "properties": {"method": {"const": "nonlinearStatic"}, "case": {"type": "string"}, "status": {"enum": ["ok", "notConverged", "unstable"]}, "accepted_factor": {"type": ["number", "null"]}, "tolerance": {"type": "number"}, "max_iterations": {"type": "integer"}, "force_scale": {"type": "number"}, "displacement_tolerance": {"type": ["number", "null"]}, "energy_tolerance": {"type": ["number", "null"]}, "displacement_scale": {"type": "number"}, "energy_scale": {"type": "number"}, "steps": {"type": "array", "items": {"$ref": "#/$defs/newton_step"}}, "failed_factor": {"type": "number", "description": "Factor whose attempted step produced a singular tangent; no trial displacements."}}},
    "soil_state": {"type": "object", "additionalProperties": false, "required": ["depth_m", "total_vertical_kpa", "pore_pressure_kpa", "effective_vertical_kpa", "assumed_parameters"], "properties": {"depth_m": {"type": "number"}, "total_vertical_kpa": {"type": "number"}, "pore_pressure_kpa": {"type": "number"}, "effective_vertical_kpa": {"type": "number"}, "assumed_parameters": {"type": "array", "items": {"type": "string"}}}},
    "soil_result": {"type": "object", "additionalProperties": false, "required": ["method", "states"], "properties": {"method": {"const": "soilProfile"}, "states": {"type": "array", "items": {"$ref": "#/$defs/soil_state"}}}},
    "consolidation_state": {"type": "object", "additionalProperties": false, "required": ["time_s", "delta_stress_kpa", "excess_pore_pressure_kpa", "settlement_m", "mean_degree"], "properties": {"time_s": {"type": "number"}, "delta_stress_kpa": {"type": "number"}, "excess_pore_pressure_kpa": {"type": "array", "items": {"type": "number"}}, "settlement_m": {"type": "number"}, "mean_degree": {"type": ["number", "null"]}}},
    "consolidation_result": {"type": "object", "additionalProperties": false, "required": ["method", "depths_m", "assumed_parameters", "states"], "properties": {"method": {"const": "consolidation1d"}, "depths_m": {"type": "array", "items": {"type": "number"}}, "assumed_parameters": {"type": "array", "items": {"type": "string"}}, "states": {"type": "array", "items": {"$ref": "#/$defs/consolidation_state"}}}}
    ,"buckling_mode": {"type": "object", "additionalProperties": false, "required": ["mode", "eigenvalue", "normalization", "shape"], "properties": {"mode": {"type": "integer", "minimum": 1}, "eigenvalue": {"type": "number"}, "normalization": {"const": "negative_kg"}, "shape": {"type": "array", "items": {"$ref": "#/$defs/node"}}}, "description": "lambda of K + lambda Kg = 0. negative_kg means the free shape satisfies phi^T (-Kg) phi = 1. The global shape is a displacement in m and rad."}
    ,"buckling_result": {"type": "object", "additionalProperties": false, "required": ["rigid_mode_count", "modes"], "properties": {"rigid_mode_count": {"type": "integer", "minimum": 0}, "modes": {"type": "array", "items": {"$ref": "#/$defs/buckling_mode"}}}, "description": "Lowest finite buckling factors. A numerically zero factor is a mechanism or rigid mode of K."}
  }
}
