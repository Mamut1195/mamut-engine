{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mamut.local/schemas/cli-program.schema.json",
  "title": "MAMUT allowed CLI program",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\r\\n]+$"
    },
    "argument": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^\\r\\n\\u0000]*$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "display_name",
    "version",
    "launcher",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "program_id": { "$ref": "#/$defs/identifier" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "$ref": "#/$defs/semver" },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "kind", "relative_path"],
      "properties": {
        "platform": { "const": "windows" },
        "kind": { "enum": ["executable", "batch"] },
        "relative_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "fixed_arguments",
          "input",
          "output",
          "timeout_ms",
          "max_output_bytes",
          "mutates_external_state"
        ],
        "properties": {
          "capability_id": { "$ref": "#/$defs/identifier" },
          "fixed_arguments": {
            "type": "array",
            "maxItems": 32,
            "items": { "$ref": "#/$defs/argument" }
          },
          "input": { "enum": ["none", "json"] },
          "output": { "enum": ["json", "text"] },
          "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 300000 },
          "max_output_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "mutates_external_state": { "type": "boolean" }
        }
      }
    }
  }
}
