from typing import Any, Callable

class EngineError(Exception):
    code: str
    entities: list[dict[str, Any]]
    cause: str
    # Disponibles para fallos de run, incluido cancelled:
    document: str
    diagnostics: list[dict[str, Any]]

class InvalidInputError(EngineError): ...
class CancelledError(EngineError): ...
class AnalysisError(EngineError): ...
class InternalEngineError(EngineError): ...

class CancelToken:
    """Token atómico: una vez cancelado no se puede restablecer."""
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def is_cancelled(self) -> bool: ...

def version() -> dict[str, Any]:
    """Versión y contratos de engine-api; __version__ conserva la cadena."""
    ...

def capabilities() -> dict[str, Any]: ...
def schema(name: str) -> dict[str, Any]: ...
def explain(code: str, lang: str | None = None) -> str: ...
def validate(input_json: str, lang: str | None = None) -> dict[str, Any]:
    """Devuelve {diagnostics: [...]}; defectos topológicos son diagnósticos."""
    ...

def run(
    input_json: str,
    progress: Callable[[dict[str, Any]], object] | None = None,
    cancel: CancelToken | None = None,
    lang: str | None = None,
) -> str:
    """JSON canónico results/1. Callback diferido, ejecutado con GIL al terminar."""
    ...

def canonical_json(input_json: str) -> str:
    """Transporte privado de la canonización engine-api, sin física en Python."""
    ...

def input_sha256(input_json: str) -> str:
    """Huella RFC 8785 calculada por engine-api sin ejecutar análisis."""
    ...
